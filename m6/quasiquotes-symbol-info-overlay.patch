+  @allowExperimental
+  private def declarationArity(using q: Quotes)(
+      typeRef: q.reflect.TypeRef
+  ): Either[TypeQuasiquoteError, Int] =
+    import q.reflect.*
+    val parameterInfos = typeRef.typeSymbol.primaryConstructor.paramSymss.flatten
+      .filter(_.isTypeParam)
+      .map(_.info)
+    parameterInfos.find:
+      case _: TypeBounds => false
+      case _ => true
+    match
+      case None => Right(parameterInfos.size)
+      case Some(_) =>
+        Left(TypeQuasiquoteError(TypeNameResolutionDiagnostics.compilerShapeUnsupported(
+          "type-parameter declaration info is not TypeBounds"
+        )))
+
